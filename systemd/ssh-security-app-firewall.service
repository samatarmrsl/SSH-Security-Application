[Unit]
Description=SSH Security Application dedicated firewall chain
Documentation=file:/opt/ssh-security-application/README.md
After=network-online.target ssh.service firewalld.service ufw.service systemd-tmpfiles-setup.service
Wants=network-online.target
Before=ssh-security-app.service

[Service]
Type=oneshot
User=sshsecurityapp
Group=sshsecurityapp
WorkingDirectory=/opt/ssh-security-application
ExecStart=/opt/ssh-security-application/.venv/bin/ssh-security-app --config /etc/ssh-security-app/config.json firewall-init --confirm-firewall-changes
ExecStop=/opt/ssh-security-application/.venv/bin/ssh-security-app --config /etc/ssh-security-app/config.json firewall-cleanup --confirm-firewall-changes
RemainAfterExit=yes
Environment=PYTHONUNBUFFERED=1
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ssh-security-app /var/log/ssh-security-app
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

[Install]
WantedBy=multi-user.target
