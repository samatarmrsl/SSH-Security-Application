[Unit]
Description=SSH Security Application collectors, detector, and response worker
Documentation=file:/opt/ssh-security-application/README.md
After=network-online.target ssh.service ssh-security-app-firewall.service systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=simple
User=sshsecurityapp
Group=sshsecurityapp
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/ssh-security-application
ExecStart=/opt/ssh-security-application/.venv/bin/ssh-security-app --config /etc/ssh-security-app/config.json service
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ssh-security-app /var/log/ssh-security-app
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

[Install]
WantedBy=multi-user.target
